{
  "name": "help-desk-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.23.5",
    "npm": ">=10.9.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --pretty",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:install": "playwright install chromium",
    "knip": "knip",
    "audit": "npm audit",
    "check": "npm run format:check && npm run lint && npm run lint:styles && npm run typecheck && npm run test:coverage && npm run knip && npm run build",
    "prepare": "husky",
    "commitlint": "commitlint",
    "lint:styles": "stylelint \"src/**/*.css\"",
    "lint:styles:fix": "stylelint \"src/**/*.css\" --fix"
  },
  "dependencies": {
    "@tanstack/react-query": "5.107.1",
    "bootstrap": "5.3.9",
    "react": "^19.3.1",
    "react-bootstrap": "2.10.10",
    "react-dom": "^19.3.1",
    "react-icons": "5.7.0",
    "react-router": "8.5.1"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@playwright/test": "1.65.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.12",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "5.1.0",
    "husky": "9.1.7",
    "knip": "6.45.1",
    "lint-staged": "17.6.1",
    "oxlint": "^1.90.0",
    "prettier": "3.10.1",
    "stylelint": "18.0.0",
    "stylelint-config-standard": "41.0.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.6",
    "vitest": "5.1.0"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,cjs,mts,cts}": [
      "oxlint --fix",
      "prettier --write"
    ],
    "*.{json,jsonc,yaml,yml,md,html,css,scss,svg}": "prettier --write",
    "*.{css,scss}": [
      "stylelint --fix",
      "prettier --write"
    ],
    "*.{json,jsonc,yaml,yml,md,html,svg}": "prettier --write"
  }
}
